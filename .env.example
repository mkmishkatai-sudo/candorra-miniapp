# Copy this file to .env locally, or set these as environment variables
# directly in your hosting provider's dashboard (Render: Environment tab).
# NEVER commit a real .env file to git. NEVER paste real values in chat.

BOT_TOKEN=YOUR_SECRET_HERE
DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=3000

# AdsGram — Block IDs are not secret, the callback secret IS.
ADSGRAM_REWARD_BLOCK_ID=50338
ADSGRAM_TASK_BLOCK_ID=task-50339
# Generate a long random string yourself (e.g. `openssl rand -hex 32`) and use
# the SAME value in AdsGram's "Reward URL" field: .../reward?userid=[userId]&secret=THIS_VALUE
ADSGRAM_CALLBACK_SECRET=YOUR_SECRET_HERE

# Reward-formula inputs — these are PLACEHOLDER ASSUMPTIONS from Phase 2's
# unit-economics framework, not measured data. Revisit after a real pilot.
# Gross revenue per completed rewarded view, in USD. 0.001 == eCPM $1.00, the HIGH end of the only
# Telegram-specific figure found (AdsGram publisher docs: ~$0.5-$1 per 1,000 impressions, page dated
# Nov 2025 - current rate UNVERIFIED). Replace with the MEASURED value (Earned / Impressions) after a pilot.
# NEVER set this above what your AdsGram dashboard actually shows.
ADSGRAM_ESTIMATED_PAYOUT_PER_REWARD=0.001
FRAUD_RESERVE_PCT=0.08
PAYOUT_COST_PCT=0.02
INFRA_RESERVE_PCT=0.10
REWARD_POOL_PCT=0.45

# Filled in later, only once the manual-approval withdrawal flow is tested (Part 2, Section D)
PAYOUT_WALLET_MNEMONIC=
TON_API_KEY=

# Withdrawals. Closed by default. Do NOT set to true until (1) a qualified lawyer has reviewed
# the crypto payout flow for the owner's jurisdiction, (2) the payout wallet reserve exists,
# and (3) manual approval has been tested. Setting it back to anything else pauses withdrawals.
WITHDRAWALS_OPEN=false
# Owner decision: $5 (5,000 coin at 1,000 coin = $1). The ledger is in USD.
MIN_WITHDRAWAL_USD=5

# Vault hold period (hours) before a reward is released to the balance. 24 is an ASSUMPTION;
# set it to match how long AdsGram can still adjust earnings (ask support), never shorter.
HOLD_HOURS=24

# Community task: one-time bonus for subscribing to the official channel.
# Bot must be an admin of this channel for getChatMember to work reliably.
OFFICIAL_CHANNEL_USERNAME=@CandorraOfficial
# Owner decision: 3 coin (of the requested 2-5 range), one-time only, owner-funded (not ad revenue).
CHANNEL_SUBSCRIBE_BONUS_USD=0.003

# Welcome Boost: a new user's first N real ad-views pay a HIGHER share (still bounded by
# that single event's real revenue - not a new liability, just front-loaded within it).
# Rationale: better first impression -> better activation -> more TOTAL future ad-views
# watched -> more total revenue over time. This is an ASSUMPTION, not measured yet.
WELCOME_BOOST_SHARE=0.70
WELCOME_BOOST_VIEWS=3

# Bot layer (replaces TeleBotHost). Set this exact URL as your webhook after deploying:
#   curl "https://api.telegram.org/bot<BOT_TOKEN>/setWebhook?url=https://YOUR-RENDER-URL/webhooks/telegram"
MINIAPP_URL=https://candorra-miniapp.onrender.com/
ADMIN_TELEGRAM_ID=6534482918

# Monetag — waiting on your real Zone ID(s). Postback URL to set in your Monetag zone settings, once
# the backend is deployed (fill in your Render URL and generate a real secret first):
#   https://YOUR-RENDER-URL/webhooks/monetag/reward?secret=YOUR_SECRET&ymid={ymid}&zone_id={zone_id}&request_var={request_var}&event_type={event_type}&reward_event_type={reward_event_type}&estimated_price={estimated_price}
MONETAG_ZONE_ID=11926475
MONETAG_POSTBACK_SECRET=YOUR_SECRET_HERE

# Real server-side daily cap, shared across both ad networks combined. This did
# NOT exist before (only a 20s cooldown did) - added 30 Sep 2026 during review.
# 80 matches the highest tier shown in the Mini App UI.
DAILY_VIEW_CAP=80
